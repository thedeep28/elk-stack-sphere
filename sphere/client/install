#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/elk-lab-install.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends curl dnsutils openssh-client sshpass jq iproute2 coreutils util-linux

install -d -m 0755 /opt/elk-lab /var/log/elk-lab
install -m 0755 /tmp/client/aliases.sh /opt/elk-lab/aliases.sh
install -m 0755 /tmp/client/benign-orchestrator.sh /opt/elk-lab/benign-orchestrator.sh
install -m 0755 /tmp/client/benign-worker.sh /opt/elk-lab/benign-worker.sh
install -m 0644 /tmp/client/traffic-profile.env /etc/default/elk-lab-benign
install -m 0644 /tmp/client/elk-lab-benign.service /etc/systemd/system/elk-lab-benign.service

/opt/elk-lab/aliases.sh
touch /var/log/elk-lab/benign.jsonl
systemctl daemon-reload
systemctl disable --now elk-lab-benign.timer 2>/dev/null || true
rm -f /etc/systemd/system/elk-lab-benign.timer
systemctl daemon-reload
systemctl enable elk-lab-benign.service
systemctl restart elk-lab-benign.service
printf 'client install complete %s\n' "$(date --iso-8601=seconds)"
