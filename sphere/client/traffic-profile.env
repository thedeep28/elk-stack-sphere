# BlueMon benign traffic profile, version 2.
# Protocol weights are mined from four MAWI samplepoint-F 15-minute summaries:
# 202501011400, 202504091400, 202507011400, and 202510011400.
# Combined IPv4+IPv6 packets among the three lab protocols:
# HTTP=78114843, SSH=6394059, FTP=254896, total=84763798.
# The summaries classify packets, not application sessions. These weights are a
# reproducible approximation; tools/mine-mawi-summaries.py regenerates them.

CLIENT_COUNT=8
WEIGHT_TOTAL=10000
WEB_WEIGHT=9216
SSH_WEIGHT=754
FTP_WEIGHT=30

# Independent workers pause between completed interactions. Parallel long FTP
# or SSH sessions therefore do not stop other clients.
THINK_MIN_SECONDS=5
THINK_MAX_SECONDS=25

WEB_REQUEST_MIN=2
WEB_REQUEST_MAX=8
WEB_THINK_MAX_SECONDS=3

# Empirical flow duration is not available in the public MAWI summary pages.
# These bounded duration buckets are explicit lab parameters and can be replaced
# after running the included miner on locally downloaded packet traces.
SSH_CDF_SHORT=650
SSH_CDF_MEDIUM=900
SSH_CDF_LONG=990
SSH_SHORT_MIN_SECONDS=1
SSH_SHORT_MAX_SECONDS=5
SSH_MEDIUM_MIN_SECONDS=6
SSH_MEDIUM_MAX_SECONDS=30
SSH_LONG_MIN_SECONDS=31
SSH_LONG_MAX_SECONDS=120
SSH_RARE_MIN_SECONDS=121
SSH_RARE_MAX_SECONDS=300

# Heavy-tailed, bounded FTP distribution. The last 0.5% reaches 2 GiB.
FTP_CDF_SMALL=700
FTP_CDF_MEDIUM=950
FTP_CDF_LARGE=995
FTP_SMALL_MIN_BYTES=65536
FTP_SMALL_MAX_BYTES=4194304
FTP_MEDIUM_MIN_BYTES=4194305
FTP_MEDIUM_MAX_BYTES=67108864
FTP_LARGE_MIN_BYTES=67108865
FTP_LARGE_MAX_BYTES=536870912
FTP_RARE_MIN_BYTES=536870913
FTP_MAX_BYTES=2147483648
FTP_UPLOAD_PERCENT=50
FTP_MAX_SIMULTANEOUS_LARGE=1
